      "id": 1,
      "targets": [
        {
          "expr": "sum by (operation, status) (rate(flashcard_operation_total[5m]))",
          "legendFormat": "{{operation}} {{status}}",
          "refId": "A"
        }
      ],
      "title": "Operation rate",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, operation) (rate(flashcard_operation_duration_ms_bucket[5m])))",
          "legendFormat": "{{operation}} p95",
          "refId": "A"
        }
      ],
      "title": "Operation latency p95",
      "type": "timeseries"
